<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{5A2D7C41-3E8B-4F92-B1D6-9C0E4A2F8B3D}</ProjectGuid>
    <OutputType>Library</OutputType>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>ModuleForge</RootNamespace>
    <AssemblyName>ModuleForge</AssemblyName>
    <TargetFrameworkVersion>v4.7.2</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
    <!-- Keeps the builder's absolute paths OUT of the shipped DLL. Without
         this, the PE debug directory embeds the full path to the .pdb
         (C:\Users\<name>\...\obj\Debug\ModuleForge.pdb) and every source file
         path goes into the .pdb - all readable out of a released DLL with
         `strings`. PathMap rewrites them to a relative form; combined with
         Deterministic it also makes the build reproducible. -->
    <PathMap>$(MSBuildProjectDirectory)=.</PathMap>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <!-- $(PunkManaged) is <your PUNK folder>\Punk_Data\Managed and $(PunkCore)
       is <your PUNK folder>\BepInEx\core. Both are resolved by
       Directory.Build.props at the repo root - see BUILDING.md. None of
       these DLLs are redistributed here; they come from your own install. -->
  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(PunkCore)\0Harmony.dll</HintPath>
    </Reference>
    <Reference Include="BepInEx.Core">
